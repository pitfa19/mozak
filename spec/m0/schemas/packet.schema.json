{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mozak.dev/spec/m0/packet.schema.json",
  "title": "MOZAK M0 packet",
  "type": "object",
  "required": ["id", "kind", "version", "state", "scope", "objective", "canonical_generation", "evidence_snapshot_hashes", "constraints", "dependencies", "acceptance_checks", "risks", "freshness"],
  "properties": {
    "id": {"type": "string", "pattern": "^pkt_[a-z0-9_]+$"},
    "kind": {"type": "string", "enum": ["research", "decision", "implementation", "operations"]},
    "version": {"type": "integer", "minimum": 1},
    "state": {"type": "string", "enum": ["draft", "reviewed", "released", "superseded", "expired", "archived"]},
    "scope": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "canonical_generation": {"type": "integer", "minimum": 1},
    "evidence_snapshot_hashes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "freshness": {
      "type": "object",
      "required": ["created_at", "review_after"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "review_after": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "released_at": {"type": "string", "format": "date-time"},
    "supersedes": {"type": "string", "pattern": "^pkt_[a-z0-9_]+$"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "released"}}}, "then": {"required": ["released_at"], "properties": {"evidence_snapshot_hashes": {"minItems": 1}}}}
  ],
  "additionalProperties": false
}
