{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mozak.dev/project-framework/package-import-approval.schema.json",
  "title": "MOZAK owner-approved local package import",
  "type": "object",
  "required": ["schema_version", "decision", "owner", "approved_at", "rationale", "package_id", "project_id", "release_id", "target_registry_sha256", "output_root"],
  "properties": {
    "schema_version": {"const": 1},
    "decision": {"const": true},
    "owner": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "approved_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "package_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "target_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_root": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
