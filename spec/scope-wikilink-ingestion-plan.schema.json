{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mozak.dev/schemas/scope-wikilink-ingestion-plan-v1.json",
  "title": "MOZAK Scope wikilink ingestion plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_manifest_sha256", "observed_revision", "scope_id", "history_entry", "existing_source_input_ids", "inclusions"],
  "properties": {
    "schema_version": {"const": 1},
    "scope_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_id": {"$ref": "#/$defs/id"},
    "history_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "at", "note"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "note": {"type": "string", "minLength": 1}}
    },
    "existing_source_input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "inclusions": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["input_id", "kind", "source_path", "source_sha256", "media_type"],
        "properties": {
          "input_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["note", "attachment"]},
          "source_path": {"type": "string", "minLength": 1, "pattern": "^[\\x20-\\x7e]+$"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"enum": ["text/markdown", "application/pdf", "image/png", "image/jpeg", "text/plain"]}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}
}
