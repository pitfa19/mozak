{
  "name": "mozak-monorepo",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -b && npm run build:plugin",
    "build:plugin": "node packages/obsidian/scripts/build.mjs",
    "build:npm": "node scripts/build-npm.mjs",
    "test": "node --test --experimental-strip-types packages/core/test/*.test.ts packages/cli/test/*.test.ts packages/mcp/test/*.test.ts packages/obsidian/test/*.test.ts",
    "test:install": "node --test scripts/test-install.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
