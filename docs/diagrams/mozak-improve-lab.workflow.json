{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How the Improve Lab works",
    "animation": "trace",
    "quality_profile": "showcase",
    "output": "mozak-improve-lab.html",
    "views": [
      {
        "id": "ordered-run",
        "label": "The ordered run",
        "focus": [
          "question",
          "start",
          "refresh",
          "select",
          "read",
          "mechanisms",
          "plans",
          "review"
        ],
        "note": "Six steps in a fixed order, each recording an immutable transition with actor, time and input hash."
      },
      {
        "id": "refusals",
        "label": "What it refuses",
        "focus": [
          "outoforder",
          "shallow",
          "notauthorized"
        ],
        "note": "Every refusal leaves the run at its current state, so the owner can repair and retry."
      },
      {
        "id": "the-stop",
        "label": "The stop",
        "focus": [
          "plans",
          "review",
          "notauthorized"
        ],
        "note": "A completed run authorizes nothing. Implementation is a separately authorized phase."
      }
    ]
  },
  "lanes": [
    {
      "id": "owner",
      "label": "Owner"
    },
    {
      "id": "run",
      "label": "Lab run"
    },
    {
      "id": "evidence",
      "label": "Evidence"
    },
    {
      "id": "gates",
      "label": "Refusals",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "open",
      "label": "Open",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "readwork",
      "label": "Select and read",
      "fromCol": 2,
      "toCol": 3,
